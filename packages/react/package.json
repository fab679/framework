{
  "name": "framework-agents-react",
  "version": "0.1.2",
  "description": "React hooks for Framework agents (streaming chat over A2A/SSE, multi-turn contexts, live tool activity)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "framework-agents": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.12",
    "eslint": "^9.12.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1"
  },
  "keywords": [
    "react",
    "hooks",
    "agents",
    "llm",
    "sse",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fab679/framework.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
