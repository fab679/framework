{
  "name": "framework-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic platform for building with agents \u2014 TypeScript + Python monorepo",
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.4.0",
    "typescript": "^5.6.3"
  }
}
