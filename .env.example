# Copy to .env (never commit .env). TogetherAI wins when its key is set.
# Get a key at https://api.together.xyz — then paste it into .env as TOGETHER_API_KEY.
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=Qwen/Qwen3.5-9B

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set to 1 to run live E2E tests that hit the network.
E2E_MODEL=


# Anthropic native API (optional — used by initChatModel("anthropic:...")).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local Ollama (no key needed — used by initChatModel("ollama:...")).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5
