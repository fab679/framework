{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "framework.json",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "default": "127.0.0.1"
        },
        "basePort": {
          "type": "integer",
          "minimum": 0,
          "default": 8484
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "envFile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "checkpointer": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        }
      },
      "required": [
        "dir"
      ],
      "additionalProperties": false
    },
    "http": {
      "type": "object",
      "properties": {
        "corsOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "agents": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "default": ""
              },
              "systemPrompt": {
                "type": "string",
                "default": "You are a helpful agent. Use tools when needed. Be concise."
              },
              "model": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "filesystem": {
                "type": "string"
              },
              "todos": {
                "type": "boolean",
                "default": false
              },
              "maxSteps": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "default": 8
              },
              "sessionDir": {
                "type": "string"
              },
              "envFile": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "model"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              }
            },
            "required": [
              "file"
            ],
            "additionalProperties": {}
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "agents"
  ],
  "additionalProperties": false
}
